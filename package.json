{
  "name": "vite-plugin-shopify-critical",
  "version": "2.0.1",
  "private": false,
  "description": "Vite plugin for inlining critical CSS/JS in Shopify themes using inline_asset_content",
  "keywords": [
    "vite",
    "vite-plugin",
    "shopify",
    "critical-css",
    "critical-js",
    "performance",
    "inline-assets",
    "inline_asset_content"
  ],
  "homepage": "https://github.com/marioloncarek/vite-plugin-shopify-critical#readme",
  "bugs": {
    "url": "https://github.com/marioloncarek/vite-plugin-shopify-critical/issues",
    "email": "mario.loncarek@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marioloncarek/vite-plugin-shopify-critical.git"
  },
  "license": "MIT",
  "author": {
    "name": "QUESTION EVERYTHING",
    "email": "mario.loncarek@gmail.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts",
    "dev": "tsdown src/index.ts --watch",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.0",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "vite": "^8.0.2"
  },
  "engines": {
    "node": ">=25.0.0",
    "npm": ">=11.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
